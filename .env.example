# Copy to .env and fill in. Never commit .env.

# ---------- Server (secret: never exposed to the browser) ----------
# Supabase project URL + anon (public) key. The server acts as the signed-in
# user with these, so Row Level Security protects every query.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite   # tried in order when the main model is busy or out of quota
# EMBEDDINGS_ENABLED=true     # local all-MiniLM-L6-v2 embeddings for semantic recall
# API_PORT=8787             # (or PORT, which most hosts set automatically)
# CORS_ORIGINS=http://localhost:5173

# ---------- Frontend (public, bundled into the browser) ----------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Leave empty locally (Vite proxies /api to the server). In production set to your API URL.
VITE_API_URL=
